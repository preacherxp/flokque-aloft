{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flokque Aloft",
  "mainBinaryName": "FlokqueAloft",
  "version": "1.0.0",
  "identifier": "com.flokque.aloft",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Keeps your computer working with the lid closed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
